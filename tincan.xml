        <name lang="en">Quiz/quiz</name>
        <description lang="en">Test your understanding of how Workato APIs power integration and automation across applications, and how APIs are created by defining triggers and actions. Explore how the Workato data table stores employee laptop requests and why the Pending Request API returns multiple items as a JSON array.</description>
      </activity>
      
        <activity
      id="http://Z-5-fmiQCOGbeW6KeEeCJe5cpXXztsH-_rise/R4b9mayCRmkOfvM4I4DZ9bmCNQeIG5wQ/17308a5d-347c-4ee2-a0a6-98b8f393e06c"
      type="http://adlnet.gov/expapi/activities/cmi.interaction"
    >
          <name lang="en">What is the primary purpose of Workato APIs in a business environment?</name>
          <description lang="en"></description>
          <interactionType>choice</interactionType>
          <correctResponsePatterns>
            
              <correctResponsePattern>choice_776fedd7-a1d2-48cd-bb5e-0ef29b731cde</correctResponsePattern>
            
          </correctResponsePatterns>
          
            <choices>
              
                <component>
                  <id>choice_0d3f3cac-1719-4b4d-9da0-d1e4469bbd1a</id>
                  <description lang="en">To store files locally for offline team access</description>
                </component>
              
                <component>
                  <id>choice_5b9a0449-7ba2-4d5e-a40a-abeded85ba4e</id>
                  <description lang="en">To create marketing campaigns across social channels</description>
                </component>
              
                <component>
                  <id>choice_19497849-4446-4ef6-aec7-90b3459d8a58</id>
                  <description lang="en">To design user interface layouts for enterprise apps</description>
                </component>
              
                <component>
                  <id>choice_776fedd7-a1d2-48cd-bb5e-0ef29b731cde</id>
                  <description lang="en">To connect applications and automate workflows between them</description>
                </component>
              
            </choices>
          
        </activity>
      
        <activity
      id="http://Z-5-fmiQCOGbeW6KeEeCJe5cpXXztsH-_rise/R4b9mayCRmkOfvM4I4DZ9bmCNQeIG5wQ/9ee23746-4abc-40c7-a47f-098e9ba4ffe5"
      type="http://adlnet.gov/expapi/activities/cmi.interaction"
    >
          <name lang="en">A manager’s mobile app calls the Pending Request API to display employee laptop requests waiting for approval. Which response format best fits this API and why?</name>
          <description lang="en"></description>
          <interactionType>choice</interactionType>
          <correctResponsePatterns>
            
              <correctResponsePattern>choice_29305118-8062-4e64-9ff3-c34992d85ab8</correctResponsePattern>
            
          </correctResponsePatterns>
          
            <choices>
              
                <component>
                  <id>choice_86aa4028-deba-4518-bc69-c2b5b2c37295</id>
                  <description lang="en">A flat file, because approval APIs should respond with one record even when several requests are pending.</description>
                </component>
              
                <component>
                  <id>choice_78962099-b3d3-4106-919e-2711cb6ba093</id>
                  <description lang="en">A flat file, because the API returns the current status field for each request.</description>
                </component>
              
                <component>
                  <id>choice_29305118-8062-4e64-9ff3-c34992d85ab8</id>
                  <description lang="en">A JSON array, because the API returns a list of pending requests rather than one single record.</description>
                </component>
              
                <component>
                  <id>choice_e14e7f09-92ac-449b-9849-05d91fe35cd2</id>
                  <description lang="en">A JSON array, because arrays are required whenever an API sends data to a phone.</description>
                </component>
              
            </choices>
          
        </activity>
      
